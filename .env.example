# ==============================================================================
# AIRWISE (AirOps-Optimizer) Environment Configuration Template
# Copy this file to .env and adjust variables as required for local development.
# WARNING: NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Persistence Configuration
# SQLite local file URI default; supports PostgreSQL (e.g. postgresql+psycopg2://user:pass@localhost:5432/airops)
DATABASE_URL=sqlite:///./airops.sqlite3
DB_ECHO=False

# Synthetic Scenario & Data Engine
SCENARIO_DATA_DIR=./data/scenarios
RANDOM_SEED_DEFAULT=42
SCENARIO_CACHE_ENABLED=True

# Predictive Analytics Configuration
MODEL_REGISTRY_DIR=./models/checkpoints
PREDICTION_CONFIDENCE_THRESHOLD=0.65
TRAIN_TEST_SPLIT_RATIO=0.20

# Optimization Engine Configuration
# Supported solvers: OR_TOOLS_CP_SAT, GREEDY_BASELINE
DEFAULT_SOLVER=OR_TOOLS_CP_SAT
SOLVER_TIME_LIMIT_SECONDS=30.0
SOLVER_NUM_WORKERS=8
SOLVER_LOG_SEARCH_PROGRESS=False

# Frontend Client Configuration (Vite expects VITE_ prefix for client-exposed vars)
VITE_API_BASE_URL=http://localhost:8000/api/v1
